{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "paths", "defaults", "sources"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 2},
    "paths": {
      "type": "object",
      "required": [
        "local_root",
        "quarantine_root",
        "lockfile",
        "run_log_root",
        "snapshot_root",
        "candidate_root"
      ],
      "additionalProperties": false,
      "properties": {
        "local_root": {"type": "string", "minLength": 1},
        "quarantine_root": {"type": "string", "minLength": 1},
        "lockfile": {"type": "string", "minLength": 1},
        "run_log_root": {"type": "string", "minLength": 1},
        "snapshot_root": {"type": "string", "minLength": 1},
        "candidate_root": {"type": "string", "minLength": 1}
      }
    },
    "defaults": {"type": "object"},
    "reference_sources": {"type": "object"},
    "projects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["skills_dir"],
        "additionalProperties": false,
        "properties": {
          "skills_dir": {"type": "string", "minLength": 1},
          "compatibility_skills_dirs": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 64
            },
            "additionalProperties": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "sources": {"type": "object"}
  }
}
