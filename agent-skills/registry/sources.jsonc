{
  "$schema": "./schemas/skills-sources.schema.json",
  "version": 2,

  "paths": {
    "local_root": "agent-skills/local",
    "quarantine_root": "agent-skills/external/quarantine",
    "lockfile": ".agent-state/skills-lock.json",
    "run_log_root": ".agent-state/skill-sync-runs",
    "snapshot_root": ".agent-state/skill-snapshots",
    "candidate_root": ".agent-state/skill-candidates"
  },

  "defaults": {
    "external": {
      "scope": "global",
      "agents": ["claude", "codex", "opencode", "pi", "reasonix", "antigravity", "cross-agent"],
      "distribution_state": "enabled",
      "audit": {
        "required": true,
        "allow_unaudited": false,
        "max_risk": "LOW",
        "allow_scripts": false
      },
      "gate": {
        "manual_approval": true,
        "approved": false
      }
    },
    "internal": {
      "scope": "project",
      "distribution_state": "enabled",
      "audit": {
        "required": false,
        "local_validate": true
      },
      "gate": {
        "manual_approval": false,
        "approved": true
      }
    }
  },

  "reference_sources": {
    "agentskills-standard": {
      "type": "external",
      "ref": "agentskills/agentskills",
      "purpose": "format and validator reference only; not distributed"
    }
  },

  "projects": {
    "auroraops-control": {
      "skills_dir": "${HOME}/work/projects/auroraops-control/.agents/skills",
      "compatibility_skills_dirs": {
        "antigravity": "${HOME}/work/projects/auroraops-control/.gemini/skills",
        "claude": "${HOME}/work/projects/auroraops-control/.claude/skills"
      }
    },
    "mac-bootstrap": {
      "skills_dir": "${HOME}/work/config/mac-bootstrap/.agents/skills",
      "compatibility_skills_dirs": {
        "claude": "${HOME}/work/config/mac-bootstrap/.claude/skills"
      }
    },
    "playground": {
      "skills_dir": "${HOME}/work/projects/playground/.agents/skills",
      "compatibility_skills_dirs": {
        "claude": "${HOME}/work/projects/playground/.claude/skills"
      }
    },
    "product_strategy": {
      "skills_dir": "${HOME}/work/projects/product_strategy/.agents/skills",
      "compatibility_skills_dirs": {
        "claude": "${HOME}/work/projects/product_strategy/.claude/skills"
      }
    },
    "www": {
      "skills_dir": "${HOME}/work/projects/www/.agents/skills",
      "compatibility_skills_dirs": {
        "claude": "${HOME}/work/projects/www/.claude/skills"
      }
    }
  },

