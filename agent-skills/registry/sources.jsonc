          "agents": ["cross-agent"],
          "reason": "Semantic retrieval over indexed local documents via the installed SAG CLI; pinned local shadow of upstream Zleap-AI/SAG-Wiki commit 61f63c660c66f9600bee6c236c3e9b079f90e105"
        }
      }
    },
