{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": 1,
  "description": "Declarative manifest of non-brew CLI tools managed by mac-bootstrap. Entries here apply to all profiles. Profile-specific entries live in private/profiles/<profile>/external-tools.json.",
  "standalone_binaries": [
    {
      "name": "agy",
      "target": "~/.local/bin/agy",
      "installer": "scripts/install-antigravity-cli.sh",
      "description": "Antigravity AI CLI"
    },
    {
      "name": "imgup",
      "target": "~/.local/bin/imgup",
      "installer": "scripts/install-imgup.sh",
      "description": "ImgBed uploader"
    }
  ],
  "external_apps": []
}
