{
  "formula_command_overrides": {
    "ripgrep": "rg"
  },
  "standalone_clis": [
    {
      "name": "antigravity",
      "commands": [
        "agy",
        "antigravity"
      ]
    }
  ],
  "chrome_gemini": {
    "enabled": true,
    "profile": "Default"
  },
  "managed_symlinks": {
    "~/.zprofile": "shell/zprofile",
    "~/.zshenv": "shell/zshenv",
    "~/.zshrc": "shell/zshrc",
    "~/.shell_env": "shell/shell_env",
    "~/.bash_profile": "shell/bash_profile",
    "~/.p10k.zsh": "shell/p10k.zsh",
    "~/.vimrc": "editors/vim/vimrc",
    "~/.vim/theme.vim": "editors/vim/themes/catppuccin-mocha.vim",
    "~/.config/nvim": "editors/neovim/config",
    "~/.hammerspoon/init.lua": "desktop/hammerspoon/init.lua",
    "~/.config/ghostty/config": "terminals/ghostty/config",
    "~/.config/herdr/config.toml": "multiplexer/herder/config.toml",
    "~/.config/topgrade.toml": "system/topgrade/topgrade.toml",
    "~/.local/bin/switch-terminal-theme.sh": "scripts/switch-terminal-theme.sh",
    "~/.local/bin/proxy-on.sh": "scripts/configure-proxies.sh",
    "~/.local/bin/proxy-off.sh": "scripts/clear-proxies.sh",
    "~/.local/bin/imgup": "scripts/imgup.sh",
    "~/work/Makefile": "workspace/Makefile",
    "~/work/PROJECTS_GUIDE.md": "workspace/PROJECTS_GUIDE.md",
    "~/work/scripts": "workspace/scripts"
  },
  "cask_overrides": {
    "microsoft-edge": {
      "app": "Microsoft Edge.app",
      "optional": true
    },
    "iterm2": {
      "app": "iTerm.app",
      "optional": true
    },
    "obs": {
      "app": "OBS.app",
      "optional": true
    },
    "obsidian": {
      "app": "Obsidian.app",
      "optional": true
    },
    "wechatwork": {
      "app": "企业微信.app",
      "optional": true
    },
    "doubao": {
      "app": "doubao.app",
      "optional": true
    },
    "visual-studio-code": {
      "app": "Visual Studio Code.app"
    },
    "clash-verge-rev": {
      "app": "Clash Verge.app"
    },
    "cloudflare-warp": {
      "app": "Cloudflare WARP.app",
      "command": "warp-cli",
      "optional": true
    },
    "uuremote": {
      "app": "UU\u8fdc\u7a0b.app",
      "optional": true
    },
    "wpsoffice-cn": {
      "app": "wpsoffice.app",
      "optional": true
    },
    "xiaomi-cloud": {
      "app": "\u5c0f\u7c73\u4e92\u8054\u670d\u52a1.app",
      "optional": true
    },
    "claude-code": {
      "app": "Claude Code.app",
      "command": "claude"
    },
    "ghostty": {
      "app": "Ghostty.app"
    },
    "hammerspoon": {
      "app": "Hammerspoon.app"
    },
    "vorssaint": {
      "app": "Vorssaint.app"
    },
    "linearmouse": {
      "app": "LinearMouse.app"
    },
    "bitwarden": {
      "app": "Bitwarden.app"
    },
    "codex": {
      "app": "Codex.app"
    },
    "cc-switch": {
      "app": "cc-switch.app",
      "command": "cc-switch",
      "optional": true
