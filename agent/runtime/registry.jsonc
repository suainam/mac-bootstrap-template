{
  // Trusted user-level registry. Repositories may opt in to a profile through
  // local Git config, but they cannot define commands or executable hooks.
  "schema_version": 1,
  "runtime": {
    "diagnostic_limit": 5,
    "diagnostic_bytes": 4096,
    // Trusted base directory. Runtime appends repository/worktree/session
    // identities before writing jobs, diagnostics, ledgers, locks or receipts.
    "log_dir": "$HOME/.local/state/mac-bootstrap-agent-runtime"
  },
  "profiles": {
    // The public default remains inert until a trusted operator adds concrete
    // formatter, parser, lint, typecheck, or focused-test commands here.
    "generic": {
      "gates": []
    },
    // First tracer-bullet profile: one real, fast, read-only Python syntax check
    // after Claude Code Edit/Write. It is deliberately narrow and is not a
    // general language profile.
    "claude-edit-smoke": {
      "gates": ["python-syntax-smoke"]
    },
    // First repository migration tracer: reuse edit feedback, compile staged
    // Python snapshots before commit, and validate dispatcher push ref metadata.
    "mac-bootstrap-template": {
      "gates": [
        "python-syntax-smoke",
        "template-staged-python-syntax",
        "template-push-ref-integrity"
      ]
    },
    // First ordinary-repository tracer. It deliberately aliases the proven
    // Python edit/commit/push gates without adding project paths or commands.
    "python-repo-smoke": {
      "gates": [
        "python-syntax-smoke",
        "template-staged-python-syntax",
        "template-push-ref-integrity"
      ]
    },
    // Parent-repository tracer: reuse the proven Python and push checks, then
    // require the staged template gitlink OID to be fetchable from its remote.
    "mac-bootstrap-parent": {
      "gates": [
        "python-syntax-smoke",
        "template-staged-python-syntax",
        "parent-submodule-pointer-reachable",
        "template-push-ref-integrity"
      ]
    }
  },
  // Gates are trusted user-level declarations. after.edit uses stage=edit;
  // after.batch uses stage=batch. action=check is read-only and target mutations
  // are restored. action=safe-fix additionally requires capability=safe-fix plus
  // a unique safe_fix.operation_id and bounded max_rounds. Blocking Git lifecycle
  // events (before.commit, before.commit-message, before.push) must be synchronous.
  // Repository content may only select a profile; it cannot add these commands or hooks.
  "gates": {
    "python-syntax-smoke": {
      "events": ["after.edit"],
      "path_globs": ["*.py", "**/*.py"],
      "command": [
        "/usr/bin/python3",
        "-c",
        "import json,os,pathlib; event=json.loads(os.environ['AGENT_RUNTIME_EVENT_JSON']); path=pathlib.Path(os.environ['AGENT_RUNTIME_REPO_ROOT'])/event['target_paths'][0]; compile(path.read_text(encoding='utf-8'),str(path),'exec')"
      ],
      "cwd": "repo",
      "mode": "sync",
      "timeout_seconds": 5,
      "failure_policy": "diagnose",
      "output_policy": "diagnostic",
      "capabilities": ["read-only"],
      "stage": "edit",
      "action": "check",
      "severity": "error",
      "rule_revision": "1"
    },
    "template-staged-python-syntax": {
      "events": ["before.commit"],
      "path_globs": ["*.py", "**/*.py"],
      "command": [
        "/usr/bin/python3",
        "-c",
        "import json,os,pathlib; event=json.loads(os.environ['AGENT_RUNTIME_EVENT_JSON']); entries=event['metadata'].get('staged_entries',[]); [compile(pathlib.Path(entry['snapshot_path']).read_text(encoding='utf-8'),entry['path'],'exec') for entry in entries if entry.get('snapshot_path') and entry['path'].endswith('.py')]"
      ],
      "cwd": "repo",
      "mode": "sync",
      "timeout_seconds": 10,
      "failure_policy": "block",
      "output_policy": "diagnostic",
      "capabilities": ["read-only", "staged-snapshot"],
      "stage": "generic",
      "action": "check",
      "severity": "error",
      "rule_revision": "1"
    },
    "parent-submodule-pointer-reachable": {
      "events": ["before.commit"],
      "path_globs": ["template"],
      "command": [
        "/usr/bin/python3",
        "-c",
        "import os,runpy; runpy.run_path(os.path.join(os.environ['AGENT_RUNTIME_LIB_DIR'],'agent_submodule_pointer_gate.py'),run_name='__main__')"
      ],
      "cwd": "repo",
      "mode": "sync",
      "timeout_seconds": 30,
      "failure_policy": "block",
      "output_policy": "diagnostic",
      "capabilities": ["read-only", "staged-snapshot", "network-read"],
      "stage": "generic",
      "action": "check",
      "severity": "error",
      "rule_revision": "1"
    },
    "template-push-ref-integrity": {
      "events": ["before.push"],
      "path_globs": [],
      "command": [
        "/usr/bin/python3",
        "-c",
        "import json,os,string; event=json.loads(os.environ['AGENT_RUNTIME_EVENT_JSON']); refs=event['metadata'].get('refs'); assert isinstance(refs,list) and refs,'before.push requires at least one ref'; allowed=set(string.hexdigits); assert all(isinstance(ref.get('local_oid'),str) and len(ref['local_oid'])==40 and set(ref['local_oid'])<=allowed and isinstance(ref.get('remote_oid'),str) and len(ref['remote_oid'])==40 and set(ref['remote_oid'])<=allowed for ref in refs),'before.push ref OIDs must be 40 hexadecimal characters'"
      ],
      "cwd": "repo",
      "mode": "sync",
      "timeout_seconds": 5,
      "failure_policy": "block",
      "output_policy": "diagnostic",
      "capabilities": ["read-only", "push-ref-metadata"],
      "stage": "generic",
      "action": "check",
      "severity": "error",
      "rule_revision": "1"
    }
  }
}
