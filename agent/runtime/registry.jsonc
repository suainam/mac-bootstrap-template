{
  // Trusted user-level registry. Repositories may opt in to a profile through
  // local Git config, but they cannot define commands or executable hooks.
  "schema_version": 1,
  "runtime": {
    "diagnostic_limit": 5,
    "diagnostic_bytes": 4096,
    // Trusted base directory. Runtime appends repository/worktree/session
    // identities before writing jobs, diagnostics, ledgers, locks or receipts.
    "log_dir": "$HOME/.local/state/mac-bootstrap-agent-runtime"
  },
  "profiles": {
    // The initial profile deliberately has no gates. Git context and isolated
    // runtime state are available; later tickets add feedback gates and adapters.
    "generic": {
      "gates": []
    }
  },
  "gates": {}
}
