{
  // Trusted user-level registry. Repositories may opt in to a profile through
  // local Git config, but they cannot define commands or executable hooks.
  "schema_version": 1,
  "runtime": {
    "diagnostic_limit": 5,
    "diagnostic_bytes": 4096,
    // Trusted base directory. Runtime appends repository/worktree/session
    // identities before writing jobs, diagnostics, ledgers, locks or receipts.
    "log_dir": "$HOME/.local/state/mac-bootstrap-agent-runtime"
  },
  "profiles": {
    // The public default remains inert until a trusted operator adds concrete
    // formatter, parser, lint, typecheck, or focused-test commands here.
    "generic": {
      "gates": []
    }
  },
  // Gates are trusted user-level declarations. after.edit uses stage=edit;
  // after.batch uses stage=batch. action=check is read-only and target mutations
  // are restored. action=safe-fix additionally requires capability=safe-fix plus
  // a unique safe_fix.operation_id and bounded max_rounds. Blocking Git lifecycle
  // events (before.commit, before.commit-message, before.push) must be synchronous.
  // Repository content may only select a profile; it cannot add these commands or hooks.
  "gates": {}
}
