{
  // Trusted user-level registry. Repositories may opt in to a profile through
  // local Git config, but they cannot define commands or executable hooks.
  "schema_version": 1,
  "runtime": {
    "diagnostic_limit": 5,
    "diagnostic_bytes": 4096,
    "log_dir": "$HOME/.local/state/mac-bootstrap-agent-runtime/logs"
  },
  "profiles": {
    // The initial profile deliberately has no gates. Later vertical tickets
    // add Git context, edit feedback, commit/push gates, and host adapters.
    "generic": {
      "gates": []
    }
  },
  "gates": {}
}
